# ==========================================
# Frontend (Vite) — plantilla de configuración
# ==========================================
#
# El .gitignore ya exceptúa este archivo (`!.env.example`), pero no existía.
# Copialo a `.env` (que sí está ignorado) y ajustá los valores:
#
#     cp .env.example .env
#
# Todo lo que empiece por VITE_ queda EMBEBIDO en el bundle que se sirve al
# navegador, así que acá no va nunca un secreto: son URLs y umbrales públicos.
# Los valores por defecto del código están en src/core/config/env.config.js.

# Backend del ERP (FastAPI). Vacío usa http://localhost:8061.
VITE_API_URL=http://localhost:8061

# Servicio OCR externo para geoextracción (fuera del backend del ERP).
# Vacío deja la captura OCR sin servicio al que llamar.
VITE_OCR_API_URL=https://ocr.catastrocbba.com

# Confianza mínima para aceptar un campo del OCR sin revisión. Vacío = 0.85.
VITE_OCR_THRESHOLD=0.96
